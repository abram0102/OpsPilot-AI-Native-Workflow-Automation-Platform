# OpsPilot environment configuration — SAFE PLACEHOLDERS ONLY.
# Copy to `.env` (never commit `.env`) and replace local-only values.
# See docs/MANUAL_SETUP.md for the human account/credential gates (H0-H5)
# and docs/DEPLOYMENT_RUNBOOK.md for the per-environment matrix.
# No variable here is a real secret; every value is either a local-only
# default or a placeholder that must be replaced per environment.

# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
NODE_ENV=development
# mock = deterministic, no network calls, no API key required (default for
# local/CI); real = calls a configured LLM/embedding provider (requires H2).
AI_MODE=mock

# -----------------------------------------------------------------------------
# PostgreSQL (infra/docker-compose.yml owns local Postgres 16 + pgvector) — T01
# -----------------------------------------------------------------------------
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://opspilot:replace-with-a-local-only-password@localhost:5432/opspilot

# -----------------------------------------------------------------------------
# Redis (infra/docker-compose.yml) — T01, stream config — T24/T25
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM_NAME=opspilot:events
REDIS_CONSUMER_GROUP=agent-workers
# T24 — the API's outbox publisher. On in the local profile (Redis comes from
# `make infra-up`); set to false to let the backlog accrue without dispatching,
# which is also exactly what happens on its own while Redis is unreachable.
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_INTERVAL_MS=2000

# -----------------------------------------------------------------------------
# Spring Boot API (services/api) — T02
# -----------------------------------------------------------------------------
API_PORT=8080
# Audience this API's resource server expects on incoming OIDC access tokens.
API_OIDC_AUDIENCE=https://api.opspilot.local
# Issuer used to validate tokens. Local/CI point this at a test-only signed
# issuer (T07); real deployments point it at the Auth0 tenant domain (H1).
API_OIDC_ISSUER_URI=https://REPLACE-ME.auth0.com/
# Set to a non-empty value ONLY in local/test profiles (T07). The production
# Spring profile must refuse to start if this is set — never a prod bypass.
API_ALLOW_TEST_ISSUER=true

# How long an invitation link stays valid (ISO-8601 duration) — T09. No
# invitation email is sent in V1; the token is shown once, to the owner/admin
# who created it, via a protected API response.
API_INVITATION_TTL=P7D

# Shared secret / audience for the machine-only internal action API (T21).
# Never accepted from a public user bearer token. Read by BOTH sides: services/api
# validates tokens with these, and services/agent mints them (T23). They must match,
# and the API refuses to start under the production profile if this secret is still
# one of the development defaults committed to this repository.
INTERNAL_SERVICE_AUDIENCE=https://internal.opspilot.local
INTERNAL_SERVICE_SIGNING_SECRET=replace-with-a-local-only-test-secret

# Where the worker reaches services/api to execute approved actions (T23).
API_BASE_URL=http://localhost:8080
# Lifetime of each minted worker token. Short on purpose: it authorises user-visible
# writes, so it is created per call rather than held.
INTERNAL_SERVICE_TOKEN_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Next.js web app (apps/web) — T04, Auth0 BFF — T08
# -----------------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Auth0 (Gate H1 — see docs/MANUAL_SETUP.md). Leave as placeholders until you
# have created a development Auth0 tenant/application yourself. Names verified
# against the actually-installed @auth0/nextjs-auth0 v4 SDK, not assumed from
# older docs — v4 renamed AUTH0_BASE_URL -> APP_BASE_URL and dropped a separate
# "session secret" name in favor of AUTH0_SECRET (see docs/DECISIONS.md).
AUTH0_DOMAIN=REPLACE-ME.auth0.com
AUTH0_CLIENT_ID=replace-with-your-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-your-auth0-client-secret
AUTH0_AUDIENCE=https://api.opspilot.local
# HttpOnly session cookie encryption key (min 32 chars). Generate with:
# openssl rand -hex 32
AUTH0_SECRET=replace-with-a-local-only-random-secret-at-least-32-chars
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Python AI worker (services/agent) — T03
# -----------------------------------------------------------------------------
AGENT_HEALTH_PORT=8000
AGENT_MAX_STEPS=12
AGENT_MAX_INPUT_TOKENS=8000
AGENT_MAX_OUTPUT_TOKENS=2000
AGENT_TOOL_TIMEOUT_SECONDS=30
# Wall-clock budget for one agent run (T19). A run that exceeds steps, tokens or
# this deadline ends FAILED with a code rather than continuing past its budget.
AGENT_MAX_RUN_SECONDS=120

# Real LLM/embedding provider config — only read when AI_MODE=real (Gate H2).
# Embedding dimension must match the `vector(1536)` column in
# docs/DATA_MODEL.md; changing providers/models requires a migration note.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=replace-with-a-current-model-id
LLM_API_KEY=replace-with-your-own-api-key-never-commit
EMBEDDING_MODEL_ID=replace-with-a-current-embedding-model-id
EMBEDDING_DIMENSIONS=1536
LLM_MONTHLY_BUDGET_USD=0

# Real-provider evaluation (T20). Two independent locks on paid usage: AI_MODE=real
# alone will NOT spend money — ALLOW_REAL_LLM_CALLS must also be set deliberately,
# so a copied .env or a stray environment cannot start incurring charges.
# `make eval-real` refuses with a full checklist until both are in place.
ALLOW_REAL_LLM_CALLS=false
EVAL_MAX_CASES=3

# Cost reporting. Left unset, reports record the provider's own token counts and a
# NULL cost — this project ships no price table, because prices change per model,
# region and account, and a stale table reads as fact. Set these to your actual
# contracted rates (US dollars per million tokens) to get a dollar figure.
LLM_INPUT_COST_PER_MTOK=
LLM_OUTPUT_COST_PER_MTOK=

# Per-call budgets for the real provider adapter (T15). Ignored when AI_MODE=mock.
# An attempt that exceeds the timeout, or a retryable failure, is retried up to
# LLM_MAX_ATTEMPTS in total (1 = no retry). After LLM_CIRCUIT_BREAKER_THRESHOLD
# consecutive failures the adapter stops calling the provider at all until the
# reset window elapses, so a broken key or an outage cannot burn the budget.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_CIRCUIT_BREAKER_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60

# -----------------------------------------------------------------------------
# Object storage — local filesystem adapter by default; S3 only when these
# are set (T13). Bucket must be private; never public-read.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.local-storage
AWS_S3_BUCKET=
AWS_REGION=
# Use short-lived credentials (instance role / GitHub OIDC) in staging and
# production. Never put long-lived AWS access keys in this file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Observability — optional, off by default
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
