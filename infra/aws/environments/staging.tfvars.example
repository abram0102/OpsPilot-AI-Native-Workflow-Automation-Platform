# Copy to staging.tfvars and fill in, at Gate H3. The real file is gitignored.
#
# Nothing secret belongs here. The database password, the Redis token and the internal signing
# secret are generated by the configuration; the Auth0 client secret and any LLM key are empty
# slots in Secrets Manager that you fill in the console. A tfvars file ends up in shell history
# and in plan output, which is the wrong place for any of them.

environment = "staging"
region      = "us-east-1"

# Your Auth0 tenant (docs/MANUAL_SETUP.md Gate H1). None of these is a secret: the issuer and
# audience appear in every token, and the client id appears in every browser redirect. The client
# *secret* is an empty Secrets Manager slot you fill in the console — it never comes through here.
oidc_issuer_uri = "https://dev-xxxxxxxx.us.auth0.com/"
oidc_audience   = "https://api.opspilot.local"
auth0_domain    = "dev-xxxxxxxx.us.auth0.com"
auth0_client_id = "replace-with-your-application-client-id"

# --- while bringing staging up -------------------------------------------------------------
#
# Narrow this to your own address first. It is the cheapest way to keep a half-deployed
# environment off the public internet, and far more reliable than hoping nobody finds the
# load balancer's DNS name.
# alb_ingress_cidrs = ["203.0.113.4/32"]

# Leave both empty until you own the DNS. Without them there is no certificate and port 80
# forwards instead of redirecting — which is what lets you reach the thing at all before DNS
# exists. `tls_enabled` in the outputs says which mode you are in.
# domain_name     = "staging.example.com"
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# --- cost levers, staging defaults ------------------------------------------------------------
# Every one of these is already the default. They are repeated here so that raising one is a
# visible edit in a reviewed file rather than an invisible change of mind.

single_nat_gateway      = true          # the single largest fixed cost in the stack
availability_zone_count = 2
db_instance_class       = "db.t4g.micro"
redis_node_type         = "cache.t4g.micro"
api_desired_count       = 1
worker_desired_count    = 1
web_desired_count       = 1
api_cpu                 = 512
api_memory_mb           = 1024
worker_cpu              = 256
worker_memory_mb        = 512
web_cpu                 = 256
web_memory_mb           = 512
log_retention_days      = 30
