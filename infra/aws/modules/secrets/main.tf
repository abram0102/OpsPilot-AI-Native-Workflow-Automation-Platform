# Secrets Manager entries (docs/TASKS.md T31 acceptance: "secrets in secrets manager, no
# hardcoded credentials"; docs/SECURITY_AND_TESTING.md §1: "Production secrets must live in a
# secrets manager").
#
# What is here and what is not:
#
#   - Values this configuration *generates* (database password, Redis auth token) are written
#     here, because something has to hold them and a human copying them by hand is worse.
#   - Values only a human can obtain (the Auth0 client secret, an LLM API key) get an empty
#     secret created with `ignore_changes` on the value. The configuration makes the slot; the
#     operator fills it at Gate H3 and no apply ever overwrites it.
#
# The second half is the part worth being deliberate about. The alternative — a variable the
# operator passes in — puts the secret in a tfvars file, a shell history and the plan output.

terraform {
  required_version = ">= 1.9.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

locals {
  # Short, because rotation is easier than recovery and a 30-day window makes a mistaken destroy
  # expensive to undo. Not zero: zero means a fat-fingered `tofu destroy` is unrecoverable.
  recovery_days = var.recovery_window_days
}

# --- generated by this configuration ---------------------------------------------------------

resource "aws_secretsmanager_secret" "database" {
  name                    = "${var.name_prefix}/database"
  description             = "PostgreSQL connection details. Generated by OpenTofu; consumed by the API task."
  recovery_window_in_days = local.recovery_days
}

resource "aws_secretsmanager_secret_version" "database" {
  secret_id = aws_secretsmanager_secret.database.id

  secret_string = jsonencode({
    host     = var.db_endpoint
    port     = var.db_port
    database = var.db_name
    username = var.db_username
    password = var.db_password
  })
}

resource "aws_secretsmanager_secret" "redis" {
  name                    = "${var.name_prefix}/redis"
  description             = "Redis endpoint and AUTH token."
  recovery_window_in_days = local.recovery_days
}

resource "aws_secretsmanager_secret_version" "redis" {
  secret_id = aws_secretsmanager_secret.redis.id

  secret_string = jsonencode({
    host       = var.redis_endpoint
    port       = var.redis_port
    auth_token = var.redis_auth_token
  })
}

# The shared secret the worker signs its internal-API tokens with (T21). Generated rather than
# supplied: ProductionSafetyGuard refuses to start if it ever matches one of the development
# defaults committed to this repository, so it has to be a real random value.
resource "random_password" "internal_service" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "internal_service" {
  name                    = "${var.name_prefix}/internal-service"
  description             = "HS256 signing secret shared by the API and the worker for /internal/v1 (ADR-045)."
  recovery_window_in_days = local.recovery_days
}

resource "aws_secretsmanager_secret_version" "internal_service" {
  secret_id     = aws_secretsmanager_secret.internal_service.id
  secret_string = random_password.internal_service.result
}

# --- slots a human fills at Gate H3 ------------------------------------------------------------

resource "aws_secretsmanager_secret" "operator_supplied" {
  for_each = var.operator_supplied_secrets

  name                    = "${var.name_prefix}/${each.key}"
  description             = each.value
  recovery_window_in_days = local.recovery_days
}

resource "aws_secretsmanager_secret_version" "operator_supplied_placeholder" {
  for_each = var.operator_supplied_secrets

  secret_id = aws_secretsmanager_secret.operator_supplied[each.key].id

  # A marker, not a credential. If this string ever reaches a running service, the service should
  # fail loudly rather than start with it — which is exactly what the API already does for the
  # internal signing secret (ProductionSafetyGuard) and what the worker does for a missing key.
  secret_string = "REPLACE-ME-AT-GATE-H3"

  lifecycle {
    # The whole point. Once the operator puts the real value in, no apply touches it again — and
    # the real value never passes through a variable, a tfvars file or a plan.
    ignore_changes = [secret_string]
  }
}
