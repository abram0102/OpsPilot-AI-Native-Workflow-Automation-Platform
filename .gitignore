# --- Secrets, never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*secrets*.yml
*secrets*.yaml

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# --- Node / pnpm / Next.js (apps/web) ---
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# --- Java / Maven (services/api) ---
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/wrapper/maven-wrapper.properties.local

# --- Python (services/agent) ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Docker / infra local state ---
infra/.volumes/
infra/postgres-data/
infra/redis-data/

# --- Local uploads / scratch storage adapter ---
.local-storage/

# --- Test / eval / benchmark output ---
benchmarks/*.local.json
evals/reports/*.local.md

# --- Terraform / AWS (infra/aws) ---
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example

# --- Generated OpenAPI client (regenerated by CI; committed intentionally — do not ignore) ---
# packages/contracts/typescript/** is tracked on purpose per docs/API_CONTRACT.md contract governance.
# Local dev-server launch config for the Claude Code browser preview. Machine-specific
# (it names an absolute Node path), so it stays out of the repository; `make web-dev`
# is the portable way to start the same server.
.claude/launch.json
